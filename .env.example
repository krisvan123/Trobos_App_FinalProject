# Optional Google Maps browser key. Restrict by HTTP referrer + Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Supabase project URL and public anon key (NEVER service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional CARTO key for native dark/light basemap raster tiles.
# Without this, keyless OpenStreetMap tiles are used in both themes.
NEXT_PUBLIC_CARTO_BASEMAPS_API_KEY=
